<view class="page">
  <view class="user-card card">
    <view class="avatar">{{avatarText}}</view>
    <view>
      <view class="nickname">{{user.nickname || '知趣用户'}}</view>
      <view class="muted">{{user.phone || ''}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">语音设置</view>
    <view class="card">
      <picker mode="selector" range="{{profileNames}}" value="{{selectedIndex}}" bindchange="onVoiceChange">
        <view class="setting-row">
          <text>助教音色</text>
          <text class="muted">{{selectedName}}</text>
        </view>
      </picker>
      <view class="setting-row">
        <text>自动播放回复</text>
        <switch checked="{{autoPlay}}" bindchange="onAutoPlayChange" />
      </view>
    </view>
  </view>

  <button class="logout-btn" bindtap="logout">退出登录</button>
</view>
