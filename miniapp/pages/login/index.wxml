<view class="login-page">
  <view class="brand">
    <view class="logo">知</view>
    <view class="brand-name">知趣课堂</view>
    <view class="brand-subtitle">用微信身份进入 AI 学习助手</view>
  </view>

  <view class="login-card">
    <button class="wechat-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onWechatLogin">
      微信一键登录
    </button>
    <view class="hint">登录后会自动创建或绑定你的学习账号</view>
  </view>
</view>
