.conversation-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f7f8fb 0%, #eef2f7 100%);
  color: #111827;
}

.message-list {
  flex: 1;
  height: calc(100vh - 156rpx);
  box-sizing: border-box;
  padding: 28rpx 24rpx 36rpx;
}

.empty-state {
  min-height: 62vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #778195;
  text-align: center;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #2563eb, #14b8a6);
  box-shadow: 0 18rpx 42rpx rgba(37, 99, 235, 0.22);
}

.empty-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.empty-desc {
  max-width: 480rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.message {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.message.user {
  justify-content: flex-end;
}

.message.assistant {
  justify-content: flex-start;
}

.avatar {
  width: 54rpx;
  height: 54rpx;
  min-width: 54rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
}

.ai-avatar {
  color: #ffffff;
  background: linear-gradient(135deg, #111827, #2563eb);
}

.user-avatar {
  color: #ffffff;
  background: #0f172a;
}

.bubble {
  max-width: 74%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  line-height: 1.65;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.06);
  backdrop-filter: blur(16rpx);
}

.message.assistant .bubble {
  border-top-left-radius: 10rpx;
}

.message.user .bubble {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb, #0ea5e9);
  border-color: transparent;
  border-top-right-radius: 10rpx;
  box-shadow: 0 16rpx 38rpx rgba(37, 99, 235, 0.18);
}

.assistant-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.assistant-name {
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}

.content {
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 30rpx;
}

.voice-bubble {
  min-width: 240rpx;
}

.voice-message {
  margin: 0;
  padding: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.voice-message::after {
  border: 0;
}

.voice-message-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
}

.message.assistant .voice-message-icon {
  background: #eef5ff;
}

.icon-btn {
  margin: 0;
  padding: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.icon-btn::after {
  border: 0;
}

.speak-btn {
  width: 48rpx;
  height: 48rpx;
  background: #eef5ff;
  flex-shrink: 0;
}

.speak-btn.playing {
  background: #dbeafe;
}

.speak-btn[disabled] {
  opacity: 1;
}

.speaker-glyph {
  position: relative;
  width: 26rpx;
  height: 24rpx;
}

.speaker-core {
  position: absolute;
  left: 0;
  top: 6rpx;
  width: 12rpx;
  height: 12rpx;
  background: #2563eb;
  border-radius: 4rpx 0 0 4rpx;
}

.speaker-core::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: -4rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 12rpx solid #2563eb;
}

.speaker-wave {
  position: absolute;
  border: 3rpx solid #2563eb;
  border-left: 0;
  border-top-color: transparent;
  border-bottom-color: transparent;
  border-radius: 50%;
}

.wave-one {
  right: 0;
  top: 6rpx;
  width: 8rpx;
  height: 12rpx;
}

.wave-two {
  right: -6rpx;
  top: 2rpx;
  width: 14rpx;
  height: 20rpx;
  opacity: 0.45;
}

.thinking {
  width: 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 24rpx;
}

.typing-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #94a3b8;
  animation: typing 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.16s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.32s;
}

@keyframes typing {
  0%, 80%, 100% {
    opacity: 0.32;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-6rpx);
  }
}

.composer-wrap {
  padding: 14rpx 20rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.82);
  border-top: 1rpx solid rgba(226, 232, 240, 0.75);
  box-shadow: 0 -14rpx 36rpx rgba(15, 23, 42, 0.05);
  backdrop-filter: blur(18rpx);
}

.voice-status {
  height: 56rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 10rpx 12rpx;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}

.voice-status.recording {
  color: #ef4444;
}

.voice-wave {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 10rpx rgba(37, 99, 235, 0.12);
}

.voice-status.recording .voice-wave {
  animation: pulse 1.15s infinite ease-out;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.32);
  }
  100% {
    box-shadow: 0 0 0 20rpx rgba(239, 68, 68, 0);
  }
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-btn {
  width: 76rpx;
  height: 76rpx;
  min-width: 76rpx;
  background: #f1f5f9;
  color: #0f172a;
}

.record-btn.recording {
  background: #ef4444;
  color: #ffffff;
}

.record-btn[disabled] {
  opacity: 0.56;
}

.mic-glyph {
  position: relative;
  width: 36rpx;
  height: 42rpx;
  flex-shrink: 0;
}

.mic-head {
  position: absolute;
  left: 50%;
  top: 0;
  width: 18rpx;
  height: 26rpx;
  border-radius: 12rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.mic-head::after {
  content: "";
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 6rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.34);
}

.mic-stem {
  position: absolute;
  left: 50%;
  top: 13rpx;
  width: 28rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
  transform: translateX(-50%);
}

.mic-base {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 4rpx;
  height: 10rpx;
  background: currentColor;
  border-radius: 4rpx;
  transform: translateX(-50%);
}

.mic-base::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 22rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.text-input {
  flex: 1;
  min-height: 76rpx;
  max-height: 176rpx;
  padding: 18rpx 24rpx 16rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #f1f5f9;
  color: #0f172a;
  font-size: 29rpx;
  line-height: 1.45;
}

.composer-actions {
  width: 76rpx;
  min-width: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn {
  width: 76rpx;
  height: 76rpx;
  background: #e5e7eb;
  color: #9ca3af;
}

.send-btn.active {
  background: #111827;
  color: #ffffff;
}

.send-btn.sending {
  background: #111827;
  color: #ffffff;
  opacity: 1;
}

.send-arrow {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 800;
  transform: translateY(-3rpx);
}

.send-spinner,
.mini-spinner {
  box-sizing: border-box;
  border-style: solid;
  border-color: currentColor;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.82s linear infinite;
}

.send-spinner {
  width: 30rpx;
  height: 30rpx;
  border-width: 4rpx;
}

.mini-spinner {
  width: 24rpx;
  height: 24rpx;
  border-width: 3rpx;
  color: #2563eb;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
